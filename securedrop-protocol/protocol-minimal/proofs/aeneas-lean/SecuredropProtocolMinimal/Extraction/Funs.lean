def sign.SigningKey.new
  {R : Type} {Clause0_Clause1_Clause0_Error : Type} (rand_coreCryptoRngInst :
  rand_core.CryptoRng R Clause0_Clause1_Clause0_Error) (rng : R) :
  Result ((core.result.Result sign.SigningKey anyhow.Error) × R)
  := do
  let (r, rng1) ←
    primitives.provider.ed25519.keygen rand_coreCryptoRngInst rng
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let (sk, vk) := val
    ok (core.result.Result.Ok { vk := vk, sk := sk }, rng1)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
        sign.SigningKey (core.convert.FromSame anyhow.Error) residual
    ok (r1, rng1)

